# =============================================================================
# ParkGuard KZ — environment variables (example)
#
# Kopyala:  cp .env.example .env
# Заполни:  .env (git'e commit YASAK; .gitignore bu dosyayı dışarıda tutar)
# =============================================================================

# -----------------------------------------------------------------------------
# Genel / General
# -----------------------------------------------------------------------------
ENV=dev                          # dev | staging | prod
PROJECT_NAME=parkguard-kz
TZ=Asia/Almaty                   # Kazakhstan (UTC+5, no DST)
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# -----------------------------------------------------------------------------
# Operator (audit only — auth YOK)
# -----------------------------------------------------------------------------
DEFAULT_OPERATOR_NAME=System

# -----------------------------------------------------------------------------
# PostgreSQL (+ PostGIS)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=parkguard
POSTGRES_USER=parkguard
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
# SQLAlchemy (async) URL
DATABASE_URL=postgresql+asyncpg://parkguard:CHANGE_ME_POSTGRES@postgres:5432/parkguard
# Alembic (sync driver)
DATABASE_URL_SYNC=postgresql+psycopg2://parkguard:CHANGE_ME_POSTGRES@postgres:5432/parkguard

# -----------------------------------------------------------------------------
# Redis (AOF persistent)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_REDIS
REDIS_URL=redis://:CHANGE_ME_REDIS@redis:6379/0

# -----------------------------------------------------------------------------
# Kafka / Redpanda
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=parkguard
KAFKA_CONSUMER_GROUP_VIOLATION=violation-service
KAFKA_CONSUMER_GROUP_PLATE=plate-service
KAFKA_CONSUMER_GROUP_SNAPSHOT=snapshot-consumer
KAFKA_CONSUMER_GROUP_PENALTY=penalty-card-service

# Topic names
KAFKA_TOPIC_DETECTIONS=detections
KAFKA_TOPIC_VIOLATIONS=violations
KAFKA_TOPIC_SNAPSHOT_REQ=snapshot_requests
KAFKA_TOPIC_SNAPSHOT_RES=snapshot_responses
KAFKA_TOPIC_OCR_REQ=ocr_requests
KAFKA_TOPIC_OCR_RES=ocr_results
KAFKA_TOPIC_PENALTY_REQ=penalty_card_requests

# -----------------------------------------------------------------------------
# MinIO (S3 uyumlu object storage)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=parkguard
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO
MINIO_BUCKET_SNAPSHOTS=snapshots
MINIO_BUCKET_CARDS=penalty-cards
MINIO_USE_SSL=false
MINIO_PRESIGN_TTL_SECONDS=900          # 15 min

# -----------------------------------------------------------------------------
# Event API
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://dashboard.local
API_RATE_LIMIT_PER_MIN=500

# -----------------------------------------------------------------------------
# DeepStream (C++ app)
# -----------------------------------------------------------------------------
DEEPSTREAM_HEALTH_PORT=9100
DEEPSTREAM_CONFIG_FILE=/app/configs/app_config.yml
DEEPSTREAM_CAMERAS_FILE=/app/configs/cameras.yml
DEEPSTREAM_MODELS_DIR=/app/models
NVIDIA_DRIVER_CAPABILITIES=compute,utility,video,graphics
NVIDIA_VISIBLE_DEVICES=all

# -----------------------------------------------------------------------------
# Plate service (Nomeroff-net 4.0.1)
# -----------------------------------------------------------------------------
PLATE_SERVICE_DEVICE=cuda            # cuda | cpu
PLATE_SERVICE_BATCH_SIZE=4
PLATE_SERVICE_CONFIDENCE_THRESHOLD=0.5
PLATE_SERVICE_ACCEPTED_REGIONS=kz,kz_box
PLATE_SERVICE_WARMUP_IMAGES=5

# -----------------------------------------------------------------------------
# Violation service thresholds (spec §1.1, §5)
# -----------------------------------------------------------------------------
VIOLATION_DEFAULT_THRESHOLD_SECONDS=20
VIOLATION_DEFAULT_EXIT_CONFIRM_SECONDS=10
VIOLATION_DEFAULT_COOLDOWN_SECONDS=10
VIOLATION_OCR_ATTEMPT_INTERVAL_SECONDS=5
VIOLATION_PLATE_VOTE_THRESHOLD=3
VIOLATION_EMBEDDING_MATCH_THRESHOLD=0.82
VIOLATION_SPATIAL_IOU_THRESHOLD=0.3
VIOLATION_CVI_INACTIVE_TTL_SECONDS=600
VIOLATION_ACTIVE_REGISTRY_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Camera credentials (RTSP) — örnek şablon
# Gerçek değerleri .env dosyasına yaz, repo'ya KOYMA!
# -----------------------------------------------------------------------------
CAMERA_DEFAULT_USER=admin
CAMERA_DEFAULT_PASSWORD=CHANGE_ME_CAMERA
# Bireysel kameralar cameras.yml içinde listelenir; credential placeholder'ları
# runtime'da bu env var'lardan inject edilir.

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA
LOKI_PORT=3100
ALERTMANAGER_PORT=9093

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_APP_TITLE=ParkGuard KZ
